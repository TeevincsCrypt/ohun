# ---------------------------------------------------------------------------
# Supabase — auth, database, and realtime call signalling.
# These two are publishable by design: they identify the project and carry no
# privileges. Row Level Security protects the data (see supabase/schema.sql).
# NEVER add the service-role key here — it bypasses RLS.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Speech-to-text (server-side only)
# ---------------------------------------------------------------------------
ASSEMBLYAI_API_KEY=

# ---------------------------------------------------------------------------
# Translation (server-side only)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# WebRTC TURN relay (server-side only).
# Preferred: Metered REST API — per-session, geo-nearest credentials.
#   METERED_APP_NAME is your Metered app subdomain
#   (e.g. "ohun" for https://ohun.metered.live).
# ---------------------------------------------------------------------------
METERED_APP_NAME=
METERED_API_KEY=

# Fallback: a static credential pair from the Metered dashboard. Only used
# when METERED_APP_NAME / METERED_API_KEY are unset.
METERED_TURN_USERNAME=
METERED_TURN_CREDENTIAL=

# ---------------------------------------------------------------------------
# Notification email (server-side only).
#
# RESEND_API_KEY comes from resend.com. EMAIL_FROM must be an address on a
# domain verified in Resend — until a domain is verified, Resend only
# delivers to the address that owns the account, so invitees get nothing.
# For a quick test, "OHUN <onboarding@resend.dev>" works without a domain
# but can ONLY send to your own Resend account address.
#
# Leave both unset to disable notification email entirely; scheduling still
# works, it just sends nothing.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="OHUN <notifications@yourdomain.com>"

# Public origin used for links inside outbound email and for the signup
# confirmation redirect, e.g. https://ohun-nu.vercel.app (no trailing slash).
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Supabase service role (server-side only). NEVER prefix this NEXT_PUBLIC_.
#
# Bypasses Row Level Security. Used for two things: reading a user's email
# out of auth.users to notify them about a scheduled call (email is
# deliberately not stored in `profiles`, which is world-readable so username
# search works, so there is no way to reach it with the anon key), and
# reading someone else's push subscription to notify THEM about a message —
# which the sender's own RLS-scoped client can never do, by design.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Push notifications for new messages (see lib/push/).
#
# A Web Push VAPID keypair, which identifies this app to push services —
# it is not tied to any one user or device. Generate your own with:
#   npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY ships to every browser (that's how a
# subscription is created) and carries no privilege on its own — nothing
# can be pushed with it alone. VAPID_PRIVATE_KEY signs the push requests
# your server sends and must stay server-side only.
#
# Leave both unset to disable push entirely; the in-app banner still works
# for anyone with the tab open, it just cannot reach anyone who is not.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Contact URI a push service may use if a subscription is misbehaving.
# Any mailto: or https: URI satisfies the spec.
VAPID_SUBJECT=mailto:support@yourdomain.com

# Opt in to AssemblyAI's Universal-3.5 Pro streaming model, which enables
# spoken-language detection and mid-sentence code-switching. Off by default:
# an account without the model does not fail cleanly — the session connects
# and then never emits a turn, which looks like working audio with no
# transcription at all. Only set this on an account known to have it.
NEXT_PUBLIC_ASSEMBLYAI_PRO=false
